msgstr "研究者"

msgid "Cover one user's server costs"
msgstr "1 ユーザー分サーバーコストを賄う"

msgid "Lab Sponsor"
msgstr "ラボスポンサー"

msgid "Fund infrastructure for a research group"
msgstr "研究グループのインフラを資金提供"

msgid "Patron"
msgstr "パトロン"

msgid "Any amount makes a difference"
msgstr "少額でも意義があります"

msgid "How Your Support Helps"
msgstr "ご支援の使途"

