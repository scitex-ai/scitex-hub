#: apps/infra/public_app/templates/public_app/landing_partials/landing_commitment.html
# DOUBLED PERCENT ON PURPOSE — this is not a typo.
# Django's {% trans %} does `msgid = value.replace("%", "%%")` before the
# lookup (django/template/base.py, Variable.resolve), so a template literal
# containing a percent sign is looked up in its DOUBLED form. With the
# single-% msgid the lookup misses and Django falls back to the English
# source — silently, with no error. Measured on the live site 2026-08-23:
#   gettext("100% open-source, forever")     -> Japanese   (found)
#   {% trans "100% open-source, forever" %}  -> English    (missed)
msgid "100%% open-source, forever"
msgstr "100% オープンソースを、これからも"

