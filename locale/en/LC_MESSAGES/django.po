# Landing pricing data is authored in Japanese in the pricing SSoT. The
# landing template translates these values at render time so the English page
# does not expose the source language.
msgid "サブスク・学術"
msgstr "Academic subscription"

msgid "サブスク・一般"
msgstr "General subscription"

msgid "ストレージ 50GB/プロジェクト/月（Standard）"
msgstr "Storage: 50 GB/project/month (Standard)"

msgid "通常利用の範囲の通信"
msgstr "Network traffic within normal use"

msgid "超過分は従量課金"
msgstr "Metered billing for overages"

msgid "月の上限は利用者が設定"
msgstr "User-set monthly limit"

msgid "対象: 大学・研究機関のメールアドレスを持つこと（学生・院生・教職員・研究員）"
msgstr "Eligibility: verified university or research-institution email address (students, graduate students, faculty, and researchers)"

msgid "オンプレ導入サポート"
msgstr "On-premises deployment support"

msgid "オンプレミス導入支援。規模に応じて個別見積。"
msgstr "On-premises deployment support; quoted by scale."

msgid "オンプレ保守サポート"
msgstr "On-premises maintenance support"

msgid "オンプレミス保守。規模に応じて個別見積。"
msgstr "On-premises maintenance; quoted by scale."

msgid "受託開発"
msgstr "Contract development"

msgid "研究・アプリ開発等。個別見積。"
msgstr "Research and application development; individual quote."

msgid "コンサル"
msgstr "Consulting"

msgid "技術・研究相談。Zoomまたは対面。時間に応じて課金（最初の30分は無料）。"
msgstr "Technical and research consultation by Zoom or in person; billed by time (first 30 minutes free)."

msgid "表示価格はすべて税込(総額)です。"
msgstr "All displayed prices include tax."

msgid "ソフトウェア、ハードウェア、クラウド、生成 AI API 等の外部利用料は原則実費です。"
msgstr "External software, hardware, cloud, and generative AI API costs are generally charged at cost."

msgid "お客様自身の既存契約や計算資源を、そのまま利用できる構成を優先します。"
msgstr "We prioritize configurations that use your existing contracts and computing resources."

msgid "SciTeX Cloud の従量課金は、料金確定後に別ページでご案内します。"
msgstr "SciTeX Cloud usage-based pricing will be published separately after rates are finalized."

msgid "上記はいずれも目安です。ご予算や状況に合わせて調整できますので、気楽にご相談ください。"
msgstr "These prices are guides; contact us to discuss adjustments for your budget and circumstances."
