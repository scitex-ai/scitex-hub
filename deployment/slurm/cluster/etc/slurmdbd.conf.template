# /etc/slurm/slurmdbd.conf -- SciTeX cluster accounting daemon (scitex-compute-01 only)
# Install: 0600 slurm:slurm. The live file holds the DB password: never cat it,
# never commit it. Fill __SLURMDBD_STORAGE_PASS__ from the MariaDB user `slurm`
# (created with: CREATE USER 'slurm'@'localhost' IDENTIFIED BY '...';
#  GRANT ALL ON slurm_acct_db.* TO 'slurm'@'localhost';).
AuthType=auth/munge
DbdHost=scitex-compute-01
DbdPort=6819
SlurmUser=slurm
LogFile=/var/log/slurm/slurmdbd.log
PidFile=/run/slurmdbd/slurmdbd.pid
StorageType=accounting_storage/mysql
StorageHost=localhost
StorageLoc=slurm_acct_db
StorageUser=slurm
StoragePass=__SLURMDBD_STORAGE_PASS__
# Metering (2026-11-27): keep --wckey (the project tag) in the accounting DB.
TrackWCKey=yes
