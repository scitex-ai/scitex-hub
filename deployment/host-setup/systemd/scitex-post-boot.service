# File: deployment/host-setup/systemd/scitex-post-boot.service
# ============================================
# SciTeX post-boot fixups for UGREEN NAS
# ============================================
# Runs once after boot to fix known UGREEN quirks:
#   - ~/.screen permissions (reset to wrong mode on reboot)
#   - User slice cgroup limits (ensure sshd always has resources)
#
# Install:
#   sudo cp -f deployment/host-setup/systemd/scitex-post-boot.service \
#        /etc/systemd/system/scitex-post-boot.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable scitex-post-boot.service

[Unit]
Description=SciTeX post-boot fixups (screen perms, cgroup limits)
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes

# Fix ~/.screen permissions for all users with home dirs
ExecStart=/bin/bash -c 'for d in /home/*/; do [ -d "${d}.screen" ] && chmod 700 "${d}.screen"; done'

# Ensure user slice cgroup limits are loaded
ExecStart=/bin/bash -c 'if [ -f /etc/systemd/system/user-.slice.d/limit.conf ]; then systemctl daemon-reload; fi'

[Install]
WantedBy=multi-user.target
