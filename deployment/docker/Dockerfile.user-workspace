# ============================================
# User Workspace Container Image
# ============================================
# This image provides a computational environment for SciTeX Hub users
# Used for SSH access and web-based code execution (Codespace/Jupyter)

FROM python:3.11-slim

# Literal by necessity — build metadata, evaluated with no Python. Pinned to
# config/branding.py CONTACT_EMAIL by tests/config/test_contact_email_ssot.py.
LABEL maintainer="SciTeX Hub <info@scitex.ai>"
LABEL description="User computational workspace for SciTeX Hub"
LABEL version="1.0.0"

# Set timezone
ENV TZ=UTC
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo -e $TZ > /etc/timezone

# Install system dependencies and Microsoft core fonts (Arial, Times New Roman, etc.)
RUN sed -i 's/main/main contrib/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
        sed -i 's/main$/main contrib/' /etc/apt/sources.list && \
    apt-get update && \
    echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    # Development tools
    build-essential \
    git \
    wget \
    curl \
    # Text editors
    vim \
    nano \
    # Terminal utilities
    tmux \
    htop \
    tree \
    less \
    # SSH client (for git operations)
    openssh-client \
    # Compression tools
    zip \
    unzip \
    bzip2 \
    # Other utilities
    ca-certificates \
    fontconfig \
    # Microsoft core fonts for scientific figures
    ttf-mscorefonts-installer \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 -s /bin/bash user && \
    echo -e "user:user" | chpasswd && \
    mkdir -p /home/user/.ssh && \
    chown -R user:user /home/user

# Install Python scientific stack
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    # Core scientific computing
    numpy==1.26.4 \
    scipy==1.12.0 \
    pandas==2.2.0 \
    # Visualization
    matplotlib==3.8.2 \
    seaborn==0.13.2 \
    plotly==5.18.0 \
    # Machine learning
    scikit-learn==1.4.0 \
    # Interactive computing
    jupyter==1.0.0 \
    jupyterlab==4.0.11 \
    ipython==8.20.0 \
    ipdb==0.13.13 \
    # Utilities
    requests==2.31.0 \
    beautifulsoup4==4.12.3 \
    tqdm==4.66.1 \
    # Development
    black==24.1.1 \
    flake8==7.0.0 \
    pytest==8.0.0

# Switch to user
USER user
WORKDIR /home/user

# Configure shell environment
RUN echo -e 'export PATH=$HOME/.local/bin:$PATH' >> ~/.bashrc && \
    echo -e 'alias ll="ls -lah"' >> ~/.bashrc && \
    echo -e 'alias python=python3' >> ~/.bashrc && \
    echo -e 'alias pip=pip3' >> ~/.bashrc && \
    echo -e 'export PS1="\\[\\e[32m\\]\\u@scitex-workspace\\[\\e[m\\]:\\[\\e[34m\\]\\w\\[\\e[m\\]\\$ "' >> ~/.bashrc

# Create useful directories
RUN mkdir -p ~/notebooks ~/scripts ~/data

# Default command (will be overridden by SSH or exec)
CMD ["/bin/bash", "-l"]

