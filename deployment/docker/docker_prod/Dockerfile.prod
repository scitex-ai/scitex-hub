# syntax=docker/dockerfile:1.4
# ============================================
# SciTeX Cloud - Production Image
# ============================================
#
# Cache Strategy Overview
# -----------------------
# Docker layers are cached top-down: if layer N changes, layers N+1, N+2... are
# all invalidated. So we order by change frequency: rare changes first.
#
#   Stage 1: slurm-builder    — SLURM from source    (changes: ~never)
#   Stage 2: apptainer-builder — Apptainer binary     (changes: ~never)
#   Stage 3: tool-builder     — yq, small binaries    (changes: ~never)
#   Stage 4: node-builder     — mermaid-cli           (changes: rarely)
#   Stage 5: python-builder   — Python deps (scitex core):
#            Layer 0: scitex[all]==2.19.4      (anchor — NEVER changes, caches PyTorch)
#            Layer A: scitex[all]==2.19.5      (latest — bump freely, ~30s rebuild)
#   Stage 6: runtime          — Final image, includes:
#            Layer B: scitex-cloud==0.10.10-alpha (installed after app COPY, ~30s)
#
# Why split Layer A and B across stages?
#   If both were in python-builder, COPY pyproject.toml + src/ would
#   invalidate Layer A's cache on every deploy. By installing scitex-cloud
#   in the runtime stage (after COPY . .), python-builder stays fully cached.
#
# Why separate stages for SLURM/Apptainer?
# Previously these were inside python-builder. That meant bumping the scitex
# version pin would invalidate SLURM/Apptainer builds too (~10 min wasted).
# As separate stages, they build in parallel and cache independently.
#
# Multi-stage builds: each FROM starts a fresh cache chain. The final runtime
# stage cherry-picks artifacts from each builder via COPY --from=.

# ============================================
# Stage 1: SLURM Client (from source)
# ============================================
# Why build from source: SLURM client version MUST match the host's SLURM
# daemon version exactly, otherwise munge authentication fails.
# This stage almost never changes (only on cluster SLURM upgrades).

FROM python:3.11-slim AS slurm-builder

ARG SLURM_VERSION=24.05.5

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        libmunge-dev \
        libhwloc-dev \
        libhttp-parser-dev \
        libjson-c-dev \
        liblz4-dev \
        libyaml-dev \
    && rm -rf /var/lib/apt/lists/* \
    # Download and build SLURM
    && curl -L -o /tmp/slurm-${SLURM_VERSION}.tar.bz2 \
        "https://download.schedmd.com/slurm/slurm-${SLURM_VERSION}.tar.bz2" \
    && cd /tmp && tar xjf slurm-${SLURM_VERSION}.tar.bz2 \
    && cd slurm-${SLURM_VERSION} \
    && ./configure --prefix=/usr --sysconfdir=/etc/slurm \
    && make -j$(nproc) \
    && make install \
    && cd / && rm -rf /tmp/slurm-*

# ============================================
# Stage 2: Apptainer/Singularity
# ============================================
# Used for container job submission on the NAS/HPC cluster.
# Pre-built .deb — fast to install, rarely changes.

FROM python:3.11-slim AS apptainer-builder

ARG APPTAINER_VERSION=1.3.4

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        uidmap \
        squashfs-tools \
        fuse2fs \
        fuse-overlayfs \
        libseccomp2 \
        fakeroot \
    && curl -L -o /tmp/apptainer.deb \
        "https://github.com/apptainer/apptainer/releases/download/v${APPTAINER_VERSION}/apptainer_${APPTAINER_VERSION}_amd64.deb" \
    && dpkg -i /tmp/apptainer.deb \
    && rm /tmp/apptainer.deb \
    && rm -rf /var/lib/apt/lists/*

# ============================================
# Stage 3: System Tools (yq, etc.)
# ============================================
# Tiny stage — downloads static binaries. Effectively never invalidated.

FROM alpine:latest AS tool-builder

RUN YQ_VERSION=v4.44.3 && \
    wget https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_amd64 \
        -O /usr/local/bin/yq && \
    chmod +x /usr/local/bin/yq

# ============================================
# Stage 4: Node.js Tools
# ============================================
# Mermaid CLI for diagram rendering. Changes rarely.

FROM node:20-slim AS node-builder

RUN npm install -g @mermaid-js/mermaid-cli

# ============================================
# Stage 5: Python Dependencies (scitex core only)
# ============================================
# Three-layer install strategy across builder + runtime:
#
#   Layer 0 (here, python-builder — "anchor"):
#     scitex[all]==2.19.4 — installs PyTorch, CUDA, scipy, scikit-learn.
#     This version is pinned to an old stable release and NEVER changes.
#     Purpose: cache the ~2GB heavy dependency tree permanently. (~15 min cold)
#
#   Layer A (here, python-builder — "update"):
#     scitex[all]==2.19.5 — overwrites scitex core to the latest version.
#     PyTorch etc. are already installed from Layer 0 and version-compatible,
#     so uv skips them and only updates scitex itself. (~30s)
#     You bump this pin freely on every publish — Layer 0 stays cached.
#
#   Layer B (in runtime stage, after COPY . .):
#     scitex-cloud — Django app installed from local source.
#     Heavy deps already in site-packages from Layer 0+A. (~30s)
#
# Why Layer 0 + Layer A instead of just Layer A?
#   scitex is published frequently (daily). If only Layer A existed,
#   bumping the version string would invalidate the layer and re-download
#   PyTorch every time (~15 min). With the anchor layer, PyTorch is cached
#   permanently. Layer A only pays for the scitex core delta.
#
#   When to update Layer 0: only when scitex changes its PyTorch/scipy
#   version requirements (rare, maybe once or twice a year).
#
# Why uv instead of pip?
#   10-50x faster resolution and install. Critical for Layer A/B rebuilds.

FROM python:3.11-slim AS python-builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_HTTP_TIMEOUT=600

WORKDIR /build

# Build tools for compiling C extensions (psycopg2, etc.)
# These are NOT copied to runtime — only the compiled .so files survive
# via the site-packages copy.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        git \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv

# --- Layer 0: Anchor — heavy deps cache (NEVER change this version) ---
# This installs PyTorch, scipy, scikit-learn, etc. as transitive deps.
# The version is intentionally old and frozen. Only update when scitex
# changes its major dependency versions (e.g., PyTorch 2.x → 3.x).
RUN uv pip install --system --no-cache "scitex[all]==2.19.4"

# --- Layer A: Latest scitex (bump freely on every publish) ---
# PyTorch etc. are already satisfied from Layer 0. uv skips them and
# only downloads/installs the scitex package itself. (~30s)
# No --no-cache here: we want uv to recognize existing packages.
RUN uv pip install --system "scitex[all]==2.19.5"

# Playwright browsers (cached separately via BuildKit cache mount)
RUN --mount=type=cache,target=/root/.cache/ms-playwright \
    python -m playwright install chromium && \
    python -m playwright install-deps

# ============================================
# Stage 6: Runtime (Final Image)
# ============================================
# Cherry-picks from all builder stages. Only runtime deps, no compilers.

FROM python:3.11-slim AS runtime

LABEL maintainer="ywatanabe@scitex.ai"
LABEL description="SciTeX Cloud - NAS"
LABEL version="0.10.10-alpha"

ARG BUILD_ID="1.0.0"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    SCITEX_CLOUD_DJANGO_SETTINGS_MODULE=config.settings.settings_prod \
    BUILD_ID=${BUILD_ID}

WORKDIR /app

# --------------------------------------------
# Runtime system packages
# --------------------------------------------
# These are runtime-only (no -dev packages, no compilers).
# Grouped by purpose for readability. This layer is large (~1GB with texlive)
# but changes rarely — only when adding/removing system dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
    # --- Process management ---
    tini \
    # --- Core utilities ---
    curl \
    netcat-openbsd \
    jq \
    git \
    gosu \
    parallel \
    # --- Container management ---
    docker.io \
    uidmap \
    fuse-overlayfs \
    # --- SLURM runtime ---
    munge \
    # --- PostgreSQL client library (runtime only, not libpq-dev) ---
    libpq5 \
    # --- LaTeX toolchain ---
    # Full scientific LaTeX: base + extras + fonts + bibtex + science packages
    texlive-latex-base \
    texlive-latex-extra \
    texlive-latex-recommended \
    texlive-fonts-recommended \
    texlive-fonts-extra \
    texlive-bibtex-extra \
    texlive-science \
    texlive-pictures \
    texlive-plain-generic \
    texlive-publishers \
    latexdiff \
    latexmk \
    ghostscript \
    poppler-utils \
    # --- Image processing ---
    imagemagick \
    # --- Browser (Chromium for Mermaid/Playwright rendering) ---
    chromium \
    fonts-liberation \
    fontconfig \
    # --- Playwright shared libraries (minimal set for headless Chromium) ---
    libglib2.0-0 \
    libnspr4 \
    libnss3 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libxcb1 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libcairo2 \
    libpango-1.0-0 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Microsoft core fonts (Arial, Times New Roman) for publication-quality figures
RUN sed -i 's/main/main contrib/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
        sed -i 's/main$/main contrib/' /etc/apt/sources.list && \
    apt-get update && \
    echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ttf-mscorefonts-installer && \
    fc-cache -fv && \
    rm -rf /var/lib/apt/lists/*

# --------------------------------------------
# Copy artifacts from builder stages
# --------------------------------------------

# Python packages + binaries (from python-builder)
COPY --from=python-builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=python-builder /usr/local/bin /usr/local/bin
COPY --from=python-builder /root/.cache/ms-playwright* /root/.cache/

# SLURM client binaries + libraries (from slurm-builder)
COPY --from=slurm-builder /usr/bin/sinfo /usr/bin/sinfo
COPY --from=slurm-builder /usr/bin/squeue /usr/bin/squeue
COPY --from=slurm-builder /usr/bin/sbatch /usr/bin/sbatch
COPY --from=slurm-builder /usr/bin/scancel /usr/bin/scancel
COPY --from=slurm-builder /usr/bin/srun /usr/bin/srun
COPY --from=slurm-builder /usr/bin/sacct /usr/bin/sacct
COPY --from=slurm-builder /usr/bin/scontrol /usr/bin/scontrol
COPY --from=slurm-builder /usr/lib/libslurm* /usr/lib/
COPY --from=slurm-builder /usr/lib/libpmi* /usr/lib/
COPY --from=slurm-builder /usr/lib/slurm /usr/lib/slurm
RUN mkdir -p /etc/slurm

# Apptainer (from apptainer-builder)
COPY --from=apptainer-builder /usr/bin/apptainer /usr/bin/apptainer
COPY --from=apptainer-builder /usr/bin/singularity /usr/bin/singularity
COPY --from=apptainer-builder /usr/libexec/apptainer /usr/libexec/apptainer
COPY --from=apptainer-builder /etc/apptainer /etc/apptainer
RUN mkdir -p /var/lib/apptainer/mnt/session && chmod 755 /var/lib/apptainer

# Node.js + mermaid-cli (runtime needs node for Vite build + mermaid rendering)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm install -g @mermaid-js/mermaid-cli && \
    rm -rf /var/lib/apt/lists/*

# yq (from tool-builder)
COPY --from=tool-builder /usr/local/bin/yq /usr/local/bin/yq

# --------------------------------------------
# ImageMagick PDF policy (allow read/write for LaTeX → PDF → PNG pipeline)
# --------------------------------------------
RUN if [ -f /etc/ImageMagick-6/policy.xml ]; then \
        sed -i 's/<policy domain="coder" rights="none" pattern="PDF" \/>/<policy domain="coder" rights="read|write" pattern="PDF" \/>/g' \
            /etc/ImageMagick-6/policy.xml || true; \
    fi

# --------------------------------------------
# User setup
# --------------------------------------------
RUN useradd -m -u 1000 scitex && \
    useradd -r -s /bin/false slurm && \
    # Match host docker socket GID
    groupmod -g 121 docker && \
    usermod -aG docker scitex && \
    mkdir -p /app/staticfiles /app/media /app/logs /app/run /app/.cache/containers && \
    chown -R scitex:scitex /app && \
    # Apptainer fakeroot requires subuid/subgid mappings
    echo "scitex:100000:65536" >> /etc/subuid && \
    echo "scitex:100000:65536" >> /etc/subgid

# --------------------------------------------
# Application code (ordered by change frequency)
# --------------------------------------------

# --- Pinned Python extras (rarely change, cache-friendly) ---
# These are fixed-version PyPI packages with no dependency on app source code.
# Placed before COPY . . so they stay cached across deploys.
COPY --from=python-builder /usr/local/bin/uv /usr/local/bin/uv
RUN uv pip install --system --no-cache daphne==4.1.2 psycopg2-binary

# package.json first — npm install is cached unless deps change
COPY --chown=scitex:scitex package.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm install && \
    touch node_modules/.install-timestamp

# Application source (changes every deploy — MUST be last COPY)
COPY --chown=scitex:scitex . .

# --- Layer B: scitex-cloud install (changes every deploy) ---
# This is the second half of the two-layer strategy. scitex[all] is already
# in site-packages (copied from python-builder). uv sees those satisfied
# constraints and only installs the delta: Django, test tools, etc.
# ~30s because heavy deps are already present.
#
# Note: We use psycopg2-binary (pre-built wheel) so no compiler needed here.
# If you add a dependency that requires C compilation, either:
#   (a) use the -binary variant, or
#   (b) add build-essential to runtime apt-get (increases image size), or
#   (c) pre-build the wheel in python-builder and copy it over.
RUN uv pip install --system --no-cache ".[django,test]"

# Note: Vite build runs at runtime (not here) because Docker volume mounts
# for static_volume would shadow build-time output. npm deps are cached
# above, so `vite build` at startup is fast (~10s).

# Entrypoint scripts
COPY deployment/docker/common/scripts/root-init.sh /root-init.sh
COPY deployment/docker/common/scripts/entrypoint-prod.sh /entrypoint.sh
RUN chmod +x /root-init.sh /entrypoint.sh

# --------------------------------------------
# Smoke test (fail the build early if critical tools are broken)
# --------------------------------------------
USER scitex
RUN pdflatex --version && \
    bibtex --version && \
    latexmk --version && \
    convert --version && \
    yq --version && \
    python --version && \
    echo "✅ Production image verified"

# Back to root — root-init.sh handles UID fixup then drops to scitex
USER root

# ============================================
# Runtime Configuration
# ============================================
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

EXPOSE 8000

# tini as PID 1: ensures proper signal forwarding and zombie reaping
# root-init.sh: fixes SLURM UID mapping, munge group, then drops to scitex
# entrypoint.sh: runs migrations, collectstatic, vite build, starts server
ENTRYPOINT ["/usr/bin/tini", "--", "/root-init.sh", "/entrypoint.sh"]

# Daphne (ASGI): required for WebSocket support (PTY terminal, collaborative editing)
CMD ["daphne", \
     "-b", "0.0.0.0", \
     "-p", "8000", \
     "--access-log", "-", \
     "--proxy-headers", \
     "config.asgi:application"]

# EOF
