# syntax=docker/dockerfile:1.4
# ============================================
# SciTeX Hub - Production Image
# ============================================
#
# Cache Strategy Overview
# -----------------------
# Docker layers are cached top-down: if layer N changes, layers N+1, N+2... are
# all invalidated. So we order by change frequency: rare changes first.
#
#   Stage 1: slurm-builder    — SLURM from source    (changes: ~never)
#   Stage 2: apptainer-builder — Apptainer binary     (changes: ~never)
#   Stage 3: tool-builder     — yq, small binaries    (changes: ~never)
#   Stage 4: node-builder     — mermaid-cli           (changes: rarely)
#   Stage 5: python-builder   — Python deps (scitex core):
#            Layer 0: scitex[all]==2.26.0      (anchor — NEVER changes, caches PyTorch)
#            Layer A: scitex[all]==2.26.0      (latest — bump freely, ~30s rebuild)
#   Stage 6: runtime          — Final image, includes:
#            Layer B: scitex-cloud==0.10.10-alpha (installed after app COPY, ~30s)
#
# Why split Layer A and B across stages?
#   If both were in python-builder, COPY pyproject.toml + src/ would
#   invalidate Layer A's cache on every deploy. By installing scitex-cloud
#   in the runtime stage (after COPY . .), python-builder stays fully cached.
#
# Why separate stages for SLURM/Apptainer?
# Previously these were inside python-builder. That meant bumping the scitex
# version pin would invalidate SLURM/Apptainer builds too (~10 min wasted).
# As separate stages, they build in parallel and cache independently.
#
# Multi-stage builds: each FROM starts a fresh cache chain. The final runtime
# stage cherry-picks artifacts from each builder via COPY --from=.

# ============================================
# Stage 1: SLURM Client (from source)
# ============================================
# Why build from source: SLURM client version MUST match the host's SLURM
# daemon version exactly, otherwise munge authentication fails.
# This stage almost never changes (only on cluster SLURM upgrades).

FROM python:3.11-slim-bookworm AS slurm-builder

ARG SLURM_VERSION=24.05.5

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        libmunge-dev \
        libhwloc-dev \
        libhttp-parser-dev \
        libjson-c-dev \
        liblz4-dev \
        libyaml-dev \
    && rm -rf /var/lib/apt/lists/* \
    # Download and build SLURM
    && curl -L -o /tmp/slurm-${SLURM_VERSION}.tar.bz2 \
        "https://download.schedmd.com/slurm/slurm-${SLURM_VERSION}.tar.bz2" \
    && cd /tmp && tar xjf slurm-${SLURM_VERSION}.tar.bz2 \
    && cd slurm-${SLURM_VERSION} \
    && ./configure --prefix=/usr --sysconfdir=/etc/slurm \
    && make -j$(($(nproc) > 4 ? $(nproc) - 2 : $(nproc))) \
    && make install \
    && cd / && rm -rf /tmp/slurm-*

# ============================================
# Stage 2: Apptainer/Singularity
# ============================================
# Used for container job submission on the NAS/HPC cluster.
# Pre-built .deb — fast to install, rarely changes.

FROM python:3.11-slim-bookworm AS apptainer-builder

ARG APPTAINER_VERSION=1.3.4

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        uidmap \
        squashfs-tools \
        fuse2fs \
        fuse-overlayfs \
        libfuse3-3 \
        libseccomp2 \
        fakeroot \
    && curl -L -o /tmp/apptainer.deb \
        "https://github.com/apptainer/apptainer/releases/download/v${APPTAINER_VERSION}/apptainer_${APPTAINER_VERSION}_amd64.deb" \
    && dpkg -i /tmp/apptainer.deb \
    && rm /tmp/apptainer.deb \
    && rm -rf /var/lib/apt/lists/*

# ============================================
# Stage 3: System Tools (yq, etc.)
# ============================================
# Pre-downloaded on host to avoid Docker DNS resolution issues on NAS.
# Host downloads: deployment/docker/docker_prod/bin/yq_linux_amd64

FROM alpine:latest AS tool-builder

COPY deployment/docker/docker_prod/bin/yq_linux_amd64 /usr/local/bin/yq
RUN chmod +x /usr/local/bin/yq

# ============================================
# Stage 3b: whisper.cpp (Speech-to-Text)
# ============================================
# Production had NO speech-to-text at all: whisper.cpp was baked only into
# docker_dev/Dockerfile, whose own comment claimed it was "baked into the image
# for consistency across dev / staging / production". It was not — measured
# 2026-08-16: 16 whisper references in the dev Dockerfile, ZERO here. So the
# /apps/llm/api/stt/ endpoint answered 503 "whisper-cli not installed" on
# scitex.ai, for every request, since it shipped.
#
# A builder stage rather than an apt line in runtime, because compiling needs
# cmake and a toolchain and the runtime stage deliberately carries neither.
# Only /opt/whisper is copied forward.

FROM python:3.11-slim-bookworm AS whisper-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake build-essential git wget ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 https://github.com/ggerganov/whisper.cpp.git /tmp/whisper.cpp \
    && cmake -S /tmp/whisper.cpp -B /tmp/whisper-build \
        -DCMAKE_BUILD_TYPE=Release \
        -DWHISPER_BUILD_SERVER=OFF \
        -DWHISPER_BUILD_EXAMPLES=ON \
        -DBUILD_SHARED_LIBS=OFF \
    && cmake --build /tmp/whisper-build --target whisper-cli -j"$(nproc)" \
    && mkdir -p /opt/whisper/bin /opt/whisper/models \
    && cp /tmp/whisper-build/bin/whisper-cli /opt/whisper/bin/whisper-cli \
    # MULTILINGUAL, deliberately. The dev image ships only ggml-tiny.en and
    # ggml-base.en, and an `.en` model cannot transcribe anything but English —
    # it silently returns English-looking text for Japanese speech. That is the
    # other half of the defect PR #611 fixed in code: the endpoint now prefers a
    # multilingual model and passes the caller's language through, but the image
    # gave it no multilingual model to choose. ~142 MB.
    && wget -q -O /opt/whisper/models/ggml-base.bin \
        "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin" \
    && rm -rf /tmp/whisper.cpp /tmp/whisper-build

# ============================================
# Stage 4: Node.js Tools
# ============================================
# Mermaid CLI for diagram rendering. Changes rarely.

FROM node:20-slim AS node-builder

RUN npm install -g @mermaid-js/mermaid-cli

# ============================================
# Stage 5: Python Dependencies (scitex core only)
# ============================================
# Three-layer install strategy across builder + runtime:
#
#   Layer 0 (here, python-builder — "anchor"):
#     scitex[all]==2.26.0 — installs PyTorch, CUDA, scipy, scikit-learn.
#     This version is pinned to an old stable release and NEVER changes.
#     Purpose: cache the ~2GB heavy dependency tree permanently. (~15 min cold)
#
#   Layer A (here, python-builder — "update"):
#     scitex[all]==2.26.0 — overwrites scitex core to the latest version.
#     PyTorch etc. are already installed from Layer 0 and version-compatible,
#     so uv skips them and only updates scitex itself. (~30s)
#     You bump this pin freely on every publish — Layer 0 stays cached.
#
#   Layer B (in runtime stage, after COPY . .):
#     scitex-cloud — Django app installed from local source.
#     Heavy deps already in site-packages from Layer 0+A. (~30s)
#
# Why Layer 0 + Layer A instead of just Layer A?
#   scitex is published frequently (daily). If only Layer A existed,
#   bumping the version string would invalidate the layer and re-download
#   PyTorch every time (~15 min). With the anchor layer, PyTorch is cached
#   permanently. Layer A only pays for the scitex core delta.
#
#   When to update Layer 0: only when scitex changes its PyTorch/scipy
#   version requirements (rare, maybe once or twice a year).
#
# Why uv instead of pip?
#   10-50x faster resolution and install. Critical for Layer A/B rebuilds.

FROM python:3.11-slim-bookworm AS python-builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_HTTP_TIMEOUT=600

WORKDIR /build

# Build tools for compiling C extensions (psycopg2, etc.)
# These are NOT copied to runtime — only the compiled .so files survive
# via the site-packages copy.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        git \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv

# --- Layer 0: Anchor — heavy deps cache (NEVER change this version) ---
# This installs PyTorch, scipy, scikit-learn, etc. as transitive deps.
# The version is intentionally old and frozen. Only update when scitex
# changes its major dependency versions (e.g., PyTorch 2.x → 3.x).
#
# 2026-06-07: bumped 2.26.0 → 2.30.1 so the [all] anchor resolves at a
# scitex version whose [all] extra includes scitex-template + scitex-audit.
# Previously, Layer 0 at 2.26.0 anchored the [all] extras to a version
# that pre-dated those submodules; the later `.[all]` install on hub
# source upgrades scitex itself but uv does NOT re-resolve [all] extras
# on upgrade, so scitex-template / scitex-audit never landed.
# See visitor_pool ImportError in v3 #4 cutover postmortem.
RUN uv pip install --system --no-cache "scitex[all]==2.30.1"

# --- Layer A: Latest scitex (bump freely on every publish) ---
# PyTorch etc. are already satisfied from Layer 0. uv skips them and
# only downloads/installs the scitex package itself. (~30s)
# No --no-cache here: we want uv to recognize existing packages.
# 2026-06-07: bumped 2.26.0 → 2.30.1 (operator dogfooding refresh).
RUN uv pip install --system "scitex[all]==2.30.1"

# --- Smoke gate: scitex umbrella extras must be importable ---
# Guards against future regressions where a Layer 0 / Layer A pin drifts
# to a scitex version whose [all] omits one of these submodules. If
# either import fails the build fails immediately rather than producing
# an image that crash-loops on cold-boot.
RUN python -c "import scitex.template; import scitex.audit; print('scitex extras OK:', scitex.template.__name__, scitex.audit.__name__)"

# Playwright browsers (cached separately via BuildKit cache mount)
RUN --mount=type=cache,target=/root/.cache/ms-playwright \
    python -m playwright install chromium && \
    python -m playwright install-deps

# ============================================
# Stage 6: Runtime (Final Image)
# ============================================
# Cherry-picks from all builder stages. Only runtime deps, no compilers.

FROM python:3.11-slim-bookworm AS runtime

LABEL maintainer="ywatanabe@scitex.ai"
LABEL description="SciTeX Hub - NAS"
LABEL version="0.10.10-alpha"

ARG SCITEX_HUB_BUILD_ID="1.0.0"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    SCITEX_HUB_DJANGO_SETTINGS_MODULE=config.settings.settings_prod \
    SCITEX_HUB_BUILD_ID=${SCITEX_HUB_BUILD_ID}

WORKDIR /app

# --------------------------------------------
# Runtime system packages
# --------------------------------------------
# These are runtime-only (no -dev packages, no compilers).
# Grouped by purpose for readability. This layer is large (~1GB with texlive)
# but changes rarely — only when adding/removing system dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
    # --- Process management ---
    tini \
    # --- Core utilities ---
    curl \
    netcat-openbsd \
    jq \
    git \
    gosu \
    parallel \
    # --- Container management ---
    docker.io \
    uidmap \
    fuse-overlayfs \
    # --- SLURM runtime ---
    munge \
    # --- PostgreSQL client library (runtime only, not libpq-dev) ---
    libpq5 \
    # --- LaTeX toolchain ---
    # Full scientific LaTeX: base + extras + fonts + bibtex + science packages
    texlive-latex-base \
    texlive-latex-extra \
    texlive-latex-recommended \
    texlive-fonts-recommended \
    texlive-fonts-extra \
    texlive-bibtex-extra \
    texlive-science \
    texlive-pictures \
    texlive-plain-generic \
    texlive-publishers \
    latexdiff \
    latexmk \
    ghostscript \
    poppler-utils \
    # --- Image processing ---
    imagemagick \
    # --- OCR (scanned PDFs / figure text) ---
    # poppler above extracts a text layer; a SCANNED page has none, and the
    # extractor's capability probe reports ocr:false without these, so the
    # Tools UI correctly refuses rather than returning a blank success.
    # jpn is not optional here: the operator's corpus is Japanese.
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-jpn \
    tesseract-ocr-jpn-vert \
    # --- Audio processing ---
    # ffmpeg converts an uploaded recording to the 16 kHz mono WAV whisper.cpp
    # requires. It was missing too, so even with the binary present the STT
    # endpoint would have accepted the upload and then failed at conversion.
    ffmpeg \
    # --- Browser (Chromium for Mermaid/Playwright rendering) ---
    chromium \
    fonts-liberation \
    fontconfig \
    # --- Playwright shared libraries (minimal set for headless Chromium) ---
    libglib2.0-0 \
    libnspr4 \
    libnss3 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libxcb1 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libx11-6 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libcairo2 \
    libpango-1.0-0 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Microsoft core fonts (Arial, Times New Roman) for publication-quality figures
RUN sed -i 's/main/main contrib/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
        sed -i 's/main$/main contrib/' /etc/apt/sources.list && \
    apt-get update && \
    echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ttf-mscorefonts-installer && \
    fc-cache -fv && \
    rm -rf /var/lib/apt/lists/*

# --------------------------------------------
# Copy artifacts from builder stages
# --------------------------------------------

# Python packages + binaries (from python-builder)
#
# --chown=1000:1000 is the scitex user (created with `useradd -u 1000` below;
# numeric because the name does not exist yet at this point in the build).
# install_apps.sh runs as scitex and REPLACES some of these packages with
# editable checkouts of the sibling app repos. Replacing a package means
# DELETING its directory tree, and unlinking site-packages/figrecipe/WHEEL
# needs write on site-packages/figrecipe/ — the file's OWN containing
# directory, not site-packages/. Left root-owned, uv dies with
# "[Errno 13] Permission denied: 'WHEEL'" on every boot (2026-07-13).
# Doing it here costs nothing: COPY writes these files anyway, so --chown
# only sets the owner as they land. A later `chown -R` could not be used
# instead — it would copy the whole ~10GB tree up into a new image layer.
COPY --from=python-builder --chown=1000:1000 /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=python-builder /usr/local/bin /usr/local/bin
COPY --from=python-builder /root/.cache/ms-playwright* /root/.cache/

# whisper.cpp binary + multilingual model (from whisper-builder).
# The paths are not arbitrary: apps/infra/llm_app/views/stt.py defaults to
# /opt/whisper/bin/whisper-cli and /opt/whisper/models, and scitex-audio is
# handed those as explicit overrides. Moving them here means moving them there.
COPY --from=whisper-builder /opt/whisper /opt/whisper
ENV WHISPER_CLI=/opt/whisper/bin/whisper-cli \
    WHISPER_MODELS_DIR=/opt/whisper/models

# SLURM client binaries + libraries (from slurm-builder)
COPY --from=slurm-builder /usr/bin/sinfo /usr/bin/sinfo
COPY --from=slurm-builder /usr/bin/squeue /usr/bin/squeue
COPY --from=slurm-builder /usr/bin/sbatch /usr/bin/sbatch
COPY --from=slurm-builder /usr/bin/scancel /usr/bin/scancel
COPY --from=slurm-builder /usr/bin/srun /usr/bin/srun
COPY --from=slurm-builder /usr/bin/sacct /usr/bin/sacct
COPY --from=slurm-builder /usr/bin/scontrol /usr/bin/scontrol
COPY --from=slurm-builder /usr/lib/libslurm* /usr/lib/
COPY --from=slurm-builder /usr/lib/libpmi* /usr/lib/
COPY --from=slurm-builder /usr/lib/slurm /usr/lib/slurm
RUN mkdir -p /etc/slurm

# Apptainer (from apptainer-builder)
COPY --from=apptainer-builder /usr/bin/apptainer /usr/bin/apptainer
COPY --from=apptainer-builder /usr/bin/singularity /usr/bin/singularity
COPY --from=apptainer-builder /usr/libexec/apptainer /usr/libexec/apptainer
COPY --from=apptainer-builder /etc/apptainer /etc/apptainer
RUN mkdir -p /var/lib/apptainer/mnt/session && chmod 755 /var/lib/apptainer

# Node.js + mermaid-cli (runtime needs node for Vite build + mermaid rendering)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm install -g @mermaid-js/mermaid-cli && \
    rm -rf /var/lib/apt/lists/*

# yq (from tool-builder)
COPY --from=tool-builder /usr/local/bin/yq /usr/local/bin/yq

# --------------------------------------------
# ImageMagick PDF policy (allow read/write for LaTeX → PDF → PNG pipeline)
# --------------------------------------------
RUN if [ -f /etc/ImageMagick-6/policy.xml ]; then \
        sed -i 's/<policy domain="coder" rights="none" pattern="PDF" \/>/<policy domain="coder" rights="read|write" pattern="PDF" \/>/g' \
            /etc/ImageMagick-6/policy.xml || true; \
    fi

# --------------------------------------------
# User setup
# --------------------------------------------
RUN useradd -m -u 1000 scitex && \
    useradd -r -s /bin/false slurm && \
    # Match host docker socket GID
    groupmod -g 121 docker && \
    usermod -aG docker scitex && \
    mkdir -p /app/staticfiles /app/media /app/logs /app/run /app/.cache/containers \
        /app/.cache/uv /app/.cache/npm /app/.apps && \
    chown -R scitex:scitex /app && \
    # Apptainer fakeroot requires subuid/subgid mappings
    echo "scitex:100000:65536" >> /etc/subuid && \
    echo "scitex:100000:65536" >> /etc/subgid

# --------------------------------------------
# Application code (ordered by change frequency)
# --------------------------------------------

# --- Pinned Python extras (rarely change, cache-friendly) ---
# These are fixed-version PyPI packages with no dependency on app source code.
# Placed before COPY . . so they stay cached across deploys.
COPY --from=python-builder /usr/local/bin/uv /usr/local/bin/uv
RUN uv pip install --system --no-cache daphne==4.1.2 psycopg2-binary

# package.json first — npm install is cached unless deps change
COPY --chown=scitex:scitex package.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm install && \
    touch node_modules/.install-timestamp

# Application source (changes every deploy — MUST be last COPY)
COPY --chown=scitex:scitex . .

# --- Layer B: scitex-cloud install (changes every deploy) ---
# This is the second half of the two-layer strategy. scitex[all] is already
# in site-packages (copied from python-builder). uv sees those satisfied
# constraints and only installs the delta: Django, test tools, etc.
# ~30s because heavy deps are already present.
#
# Note: We use psycopg2-binary (pre-built wheel) so no compiler needed here.
# If you add a dependency that requires C compilation, either:
#   (a) use the -binary variant, or
#   (b) add build-essential to runtime apt-get (increases image size), or
#   (c) pre-build the wheel in python-builder and copy it over.
RUN uv pip install --system --no-cache ".[all]"

# --- Layer C0: Anchor — cache ecosystem packages (bump rarely) ---
# Pinned versions to cache the dependency tree. Only update when
# you want to reset the cache baseline.
#
# 2026-06-10: scitex-writer 2.10.1 → 2.17.5 (aggregate release of
#   G2 atomic .preview write (#124), G3 flock per-name serialisation
#   (#125), G1 CompilationResult schema unification (#126)). The
#   release-level fixes for the prod preview-compile race that this
#   image needs to ship live here; Django consumer updated below to
#   convert the new dataclass response to a JSON-serialisable dict.
# 2026-07-08: scitex-writer 2.17.5 → 2.26.1 (repaired wheel — the
#   2.18.0–2.26.0 wheels dropped src/scitex_writer/_dataclasses/config/
#   from the sdist; 2.26.1 ships intact and the smoke test below
#   verifies the import chain). Both 2.17.5 and 2.26.1 create the
#   dot-prefixed {project}/.scitex/writer layout the visitor-pool
#   marker verification checks (TEMPLATE_MARKER_RELPATH).
# 2026-07-09: scitex-template pinned EXPLICITLY to 0.6.8. Two bugs bit here:
#   (1) the earlier >=0.6.8 pin broke the build — 0.6.8 was not yet on PyPI
#       (uv: "only scitex-template<=0.6.7 is available"), taking prod down;
#   (2) 0.6.7's clone_scitex_minimal does `from scitex_scholar import
#       ensure_workspace`, which on scitex-scholar >=1.4 binds the SUBMODULE
#       (not callable) → "'module' object is not callable" → clone returns
#       falsy → every visitor slot quarantined (proven on staging).
#   0.6.8 (published via the v0.6.8 tag) imports the callable from the
#   scitex_scholar.ensure_workspace submodule. Together with the hub-side
#   marker-path fix (#319) and scitex-writer 2.26.1, visitor slots re-clean.
# 2026-08-11: 0.6.8 -> 0.7.0, and this pin is now LOAD-BEARING FOR CODE, not
#   just for behaviour. 0.7.0 adds `clone_template_result() -> CloneOutcome`,
#   which visitor_pool/template_clone.py imports UNCONDITIONALLY — there is no
#   fallback to the bool-returning `clone_template`, deliberately, because a
#   silent downgrade would restore exactly the blindness this change removes
#   (0.6.8 could only answer True/False, so a failed visitor reset could only
#   ever say "Template clone returned falsy" — 14 slots, five days, no cause).
#   Verified present before pinning: PyPI scitex-template 0.7.0 published
#   2026-08-11 by the v0.7.0 tag; lesson (1) above is what happens when a pin
#   moves ahead of the artifact, so it was checked rather than assumed.
# 2026-08-16: figrecipe 0.34.3 -> 0.34.5. Below 0.34.5 the Template Gallery is
#   EMPTY in any INSTALLED deployment — every category renders "No templates
#   available for this category". figrecipe's _EXAMPLES_DIR climbed out of the
#   package into examples/02_plot_and_reproduce_all_out, generated output that
#   is uncommitted and therefore absent from the wheel, so the path resolved
#   into site-packages and found nothing. 0.34.5 (PR #350) moves the assets to
#   package data at src/figrecipe/_django/gallery_templates/ and resolves them
#   relative to the package root. An older figrecipe here is not merely older,
#   it is visibly broken on the demo path. Checked before pinning, per lesson
#   (1) above: PyPI figrecipe 0.34.5 published 2026-08-16T15:37:03Z, and the
#   PUBLISHED wheel was downloaded and inspected — 36 gallery_templates
#   entries (18 yaml + 18 png) are present in the artifact this line installs.
RUN uv pip install --system --no-cache \
    "figrecipe==0.34.5" \
    "scitex-io==0.2.3" \
    "scitex-stats==0.2.6" \
    "scitex-plt==0.24.0" \
    "scitex-writer==2.26.1" \
    "scitex-template==0.7.0" \
    "scitex-linter==0.3.1" \
    "scitex-ui==0.6.3" \
    "openalex-local==0.6.0" \
    "crossref-local==0.6.4"

# --- Layer C1: Latest versions (bump freely) ---
# Overwrites C0 packages to latest. C0 deps are already satisfied,
# so this only downloads the delta. (~10s)
#
# scitex-writer is EXCLUDED from this blanket upgrade (2026-07-08,
# visitor-pool outage): every PyPI wheel 2.18.0–2.26.0 is broken —
# the v2.18.0 pyproject sdist exclude "config" (unanchored, matches at
# any depth) drops src/scitex_writer/_dataclasses/config/ from the
# sdist, so wheels built from it raise
# ModuleNotFoundError: scitex_writer._dataclasses.config on
# `import scitex_writer.writer`. That broke ensure_workspace() →
# scitex.template clone_scitex_minimal → EVERY visitor-slot
# wipe+verify reset (all 16 slots quarantined, zero writable slots).
# scitex-writer stays on the C0 pin (now 2.26.1, the repaired wheel);
# bump the C0 pin deliberately per release, and the smoke test below
# will fail the build if the wheel is broken again. scitex-template is
# likewise excluded — it stays on the deliberate C0 pin (==0.6.8).
#
# The trailing `find ... -exec chown` re-owns the root-owned DELTA: every
# `uv pip install --system` layer above ran as ROOT, so the packages they wrote
# are root-owned — unlike the bulk copied from python-builder, which the
# COPY --chown already landed as scitex. install_apps.sh runs as the scitex
# user and REPLACES several of these very packages (figrecipe, scitex-ui,
# scitex-writer, ...) with editable sibling checkouts, which means DELETING
# their directories — impossible while those directories are root-owned.
# It lives inside this same RUN so it does not become an extra image layer, and
# `! -user scitex` keeps that layer small: only this few-hundred-MB delta is
# copied up, never the ~10GB already-correct torch/scipy tree. (No -xdev needed
# — the read-only binds docker-compose mounts inside site-packages at runtime
# do not exist at build time.)
RUN uv pip install --system --no-cache --upgrade \
    "figrecipe" \
    "scitex-io" \
    "scitex-stats" \
    "scitex-plt" \
    "scitex-linter" \
    "scitex-ui" \
    "openalex-local" \
    "crossref-local" && \
    find /usr/local/lib/python3.11/site-packages ! -user scitex \
        -exec chown scitex:scitex {} +

# Note: Vite build runs at runtime (not here) because Docker volume mounts
# for static_volume would shadow build-time output. npm deps are cached above
# (and .dockerignore keeps `COPY . .` from clobbering them), so startup skips
# `npm install` — but the Vite build itself is NOT fast.
#
# MEASURED 2026-07-30 on a full build: 2m14.9s wall / 2m26.3s CPU
# (443 rollup entry points, 600 output files, 10.46 MB emitted).
# The note here previously claimed "~10s", wrong by ~13x. Budget accordingly:
# the NAS CPU is weaker than the machine that produced that figure, so the
# real boot cost is >= 2m15s, not less.

# Entrypoint scripts
COPY deployment/docker/common/scripts/root-init.sh /root-init.sh
COPY deployment/docker/common/scripts/entrypoint-prod.sh /entrypoint.sh
RUN chmod +x /root-init.sh /entrypoint.sh

# --------------------------------------------
# Smoke test (fail the build early if critical tools are broken)
# --------------------------------------------
USER scitex
RUN pdflatex --version && \
    bibtex --version && \
    latexmk --version && \
    convert --version && \
    yq --version && \
    python --version && \
    # Tools/extract-pdf: poppler pulls the text layer and the embedded
    # figures; tesseract is what makes a SCANNED page readable at all.
    pdftotext -v && \
    pdfimages -v && \
    tesseract --version && \
    # The Japanese traineddata specifically — tesseract installs and runs
    # fine without it, then returns confident nonsense for a Japanese scan.
    tesseract --list-langs 2>&1 | grep -qx jpn && \
    # Tools/transcribe-audio. whisper-cli lives outside PATH, so this
    # checks the env var the application actually resolves.
    "$WHISPER_CLI" --help > /dev/null 2>&1 && \
    test -s "$WHISPER_MODELS_DIR/ggml-base.bin" && \
    ffmpeg -version > /dev/null && \
    echo "✅ Production image verified"

# Writer/template import smoke test (2026-07-08 visitor-pool outage):
# `import scitex_writer.writer` exercises the exact import chain the
# visitor-slot reset uses (ensure_workspace → writer → _compile →
# _dataclasses → config). A wheel missing a subpackage (the
# 2.18.0–2.26.0 PyPI breakage) fails the BUILD here instead of
# quarantining all 16 slots at runtime.
# NOTE: a REAL clone_scitex_minimal is deliberately NOT run here — the
# writer workspace clone is a `git clone` of
# github.com/ywatanabe1989/scitex-writer at call time, so it would make
# the build depend on GitHub availability. The marker-layout contract
# (.scitex/writer, TEMPLATE_MARKER_RELPATH) is instead reality-locked in
# tests/apps/project_app/services/visitor_pool/
# test_template_marker_reality.py.
RUN python -c "import scitex_writer.writer" && \
    python -c "from scitex.template import clone_template" && \
    python -c "from scitex_template import clone_scitex_minimal" && \
    echo "✅ scitex-writer + template import chain verified"

# Back to root — root-init.sh handles UID fixup then drops to scitex
USER root

# ============================================
# Runtime Configuration
# ============================================
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

EXPOSE 8000

# tini as PID 1: ensures proper signal forwarding and zombie reaping
# root-init.sh: fixes SLURM UID mapping, munge group, then drops to scitex
# entrypoint.sh: runs migrations, collectstatic, vite build, starts server
ENTRYPOINT ["/usr/bin/tini", "--", "/root-init.sh", "/entrypoint.sh"]

# Daphne (ASGI): required for WebSocket support (PTY terminal, collaborative editing)
CMD ["daphne", \
     "-b", "0.0.0.0", \
     "-p", "8000", \
     "--access-log", "-", \
     "--proxy-headers", \
     "config.asgi:application"]

# EOF
