# SciTeX Hub - Environment Template
# Copy to .env.dev, .env.staging, or .env.prod and fill in values

# ========================================
# Django Settings
# ========================================
SCITEX_HUB_DJANGO_SETTINGS_MODULE=config.settings.settings_dev
DEBUG=True

# ========================================
# SciTeX Environment
# ========================================
SCITEX_ENV=dev
SCITEX_HUB_ENV=dev

# ========================================
# Server Ports
# ========================================
SCITEX_HUB_HTTP_PORT_DEV=8000

# Secret Key (generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
SCITEX_HUB_DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_NEW_SECRET

# ========================================
# Domain & Security
# ========================================
SCITEX_HUB_SERVER_IP=127.0.0.1
SCITEX_HUB_DOMAIN=127.0.0.1
SCITEX_HUB_GIT_DOMAIN=127.0.0.1
SCITEX_HUB_SITE_URL=http://127.0.0.1:8000
SCITEX_HUB_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# SSL/HTTPS Settings
SCITEX_HUB_ENABLE_SSL_REDIRECT=false
SCITEX_HUB_FORCE_HTTPS_COOKIES=false

# ========================================
# Database - PostgreSQL
# ========================================
# NOTE (2026-06-02, issue #150): the SCITEX_CLOUD_* prefix was renamed to
# SCITEX_HUB_* during the scitex-cloud → scitex-hub rebrand. Compose files
# (deployment/docker/docker_prod/docker-compose.yml:147,276 and others)
# now reference ${SCITEX_HUB_POSTGRES_USER}/_PASSWORD/_DB with no default
# fallback. Live .env.{dev,nas,prod,staging} files MUST use the SCITEX_HUB_
# prefix — leaving SCITEX_CLOUD_POSTGRES_USER causes empty substitution
# and libpq falls back to the OS user, producing 28P01 "password
# authentication failed for user \"<os-user>\"" errors (e.g. umami restart
# loop in #150).
SCITEX_HUB_POSTGRES_DB=scitex_hub_dev
SCITEX_HUB_POSTGRES_USER=scitex_dev
SCITEX_HUB_POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
SCITEX_HUB_POSTGRES_URL=postgresql://scitex_dev:CHANGE_ME_DB_PASSWORD@postgres:5432/scitex_hub_dev  # pragma: allowlist secret

SCITEX_HUB_DB_NAME_DEV=scitex_hub_dev
SCITEX_HUB_DB_USER_DEV=scitex_dev
SCITEX_HUB_DB_PASSWORD_DEV=CHANGE_ME_DB_PASSWORD
SCITEX_HUB_DB_HOST_DEV=postgres
SCITEX_HUB_DB_PORT_DEV=5432

# ========================================
# Cards board store (scitex-cards)
# ========================================
# THE /apps/cards/ BOARD READS ITS OWN DATABASE, NOT THE HUB'S. Leaving this
# unset is what made https://scitex.ai/apps/cards/graph answer HTTP 500 and
# render 0 images (operator, 2026-08-17: cards が読み込めていない). Since the
# 2026-08-13 zero-config abolition scitex-cards REFUSES to invent a default
# store rather than silently serve a stale local SQLite file, so an unset
# value is a hard, permanent refusal -- not a degraded mode that heals.
#
# config/settings/_optional_apps.py:publish_cards_store_target() publishes
# this as $SCITEX_CARDS_DB, the variable the package itself reads, alongside
# the board mount. Setting $SCITEX_CARDS_DB directly still wins if you need a
# per-process override.
#
# THE VALUE IS PER HOST -- do not copy the example. The fleet convention is a
# per-host PostgreSQL on port 55432 (5432 is never a scitex port); confirm
# what this host actually resolves to with `scitex-cards resolve-store`
# before filling it in. Unset here means the board answers a 404 naming this
# variable instead of a 500, which is legible but is still not a board.
#
# INSIDE A CONTAINER 127.0.0.1 IS THE CONTAINER, not the host. When the cards
# database runs on the host, address it as host.docker.internal:55432 --
# docker-compose.prod.yml already maps that name via
# `extra_hosts: host.docker.internal:host-gateway`.
SCITEX_HUB_CARDS_STORE=postgresql://scitex_cards@127.0.0.1:55432/scitex_cards

# ========================================
# Redis Cache
# ========================================
SCITEX_HUB_REDIS_URL=redis://redis:6379/0

# ========================================
# Logging
# ========================================
SCITEX_LOGGING_LEVEL=info

# ========================================
# Email Configuration
# ========================================
SCITEX_HUB_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SCITEX_HUB_EMAIL_HOST=smtp.example.com
SCITEX_HUB_EMAIL_PORT=587
SCITEX_HUB_EMAIL_USE_TLS=True
SCITEX_HUB_EMAIL_HOST_USER=no-reply@example.com
SCITEX_HUB_EMAIL_HOST_PASSWORD=CHANGE_ME_EMAIL_PASSWORD

SCITEX_HUB_EMAIL_ADMIN=admin@example.com
SCITEX_HUB_EMAIL_SUPPORT=support@example.com
SCITEX_HUB_EMAIL_NO_REPLY=no-reply@example.com

# Where site-down / recovery / request-flood alarms are sent
# (apps/infra/public_app/tasks/health.py). UNSET MEANS NO ALARM REACHES ANYONE
# — check_site_health still runs every 60s, still detects the outage, and then
# has nowhere to send it. It was absent from every env template until
# 2026-08-10, which is why it was never set. The task now says so at WARNING
# rather than DEBUG, but a value here is what actually arms it.
SCITEX_HUB_HEALTH_NOTIFICATION_RECIPIENT=admin@example.com
# Optional; defaults to the noreply address from config/branding.py.
# SCITEX_HUB_HEALTH_NOTIFICATION_SENDER=no-reply@example.com

# ========================================
# Gitea Integration
# ========================================
SCITEX_HUB_GITEA_URL_DEV=http://127.0.0.1:3000
SCITEX_HUB_GITEA_HTTP_PORT_DEV=3000
SCITEX_HUB_GITEA_SSH_PORT_DEV=2222
SCITEX_HUB_GITEA_API_URL_DEV=http://127.0.0.1:3000/api/v1

SCITEX_HUB_GITEA_URL_IN_HOST_DEV=http://127.0.0.1:3000
SCITEX_HUB_GITEA_URL_IN_CONTAINER_DEV=http://gitea:3000

SCITEX_HUB_GITEA_ADMIN_USERNAME=scitex_admin
SCITEX_HUB_GITEA_ADMIN_PASSWORD=CHANGE_ME_GITEA_PASSWORD
SCITEX_HUB_GITEA_ADMIN_EMAIL=admin@example.com
SCITEX_HUB_GITEA_TOKEN_DEV=CHANGE_ME_GITEA_TOKEN

# ========================================
# CrossRef/OpenAlex Local Database
# ========================================
CROSSREF_LOCAL_MODE=http
CROSSREF_LOCAL_API_URL=http://host.docker.internal:31291
CROSSREF_LOCAL_PORT=31291

OPENALEX_LOCAL_MODE=http
OPENALEX_LOCAL_API_URL=http://host.docker.internal:31292
OPENALEX_LOCAL_PORT=31292

# ========================================
# SciTeX Scholar Configuration
# ========================================
SCITEX_SCHOLAR_USE_CACHE=True
SCITEX_SCHOLAR_MAX_WORKERS=8
SCITEX_SCHOLAR_TIMEOUT_PER_ENGINE=30
SCITEX_SCHOLAR_ENGINES=CrossRef,PubMed,Semantic_Scholar,arXiv,OpenAlex
SCITEX_SCHOLAR_DEFAULT_MODE=parallel
SCITEX_SCHOLAR_DEBUG_MODE=true
SCITEX_SCHOLAR_PDF_MAX_PARALLEL=8

# Scholar Email
SCITEX_SCHOLAR_FROM_EMAIL_ADDRESS=no-reply@example.com
SCITEX_SCHOLAR_FROM_EMAIL_SENDER_NAME="SciTeX Scholar"
SCITEX_SCHOLAR_FROM_EMAIL_SMTP_SERVER=smtp.example.com
SCITEX_SCHOLAR_FROM_EMAIL_SMTP_PORT=587
SCITEX_SCHOLAR_FROM_EMAIL_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
SCITEX_SCHOLAR_TO_EMAIL_ADDRESS=your@email.com
SCITEX_SCHOLAR_CROSSREF_EMAIL=your@email.com
SCITEX_SCHOLAR_PUBMED_EMAIL=your@email.com

# ========================================
# SciTeX Public API
# ========================================
SCITEX_HUB_CAMPAIGN_API_KEY=CHANGE_ME_API_KEY

# Scholar API Endpoints
SCITEX_SCHOLAR_CROSSREF_API_URL_EXTERNAL=https://scitex.ai/scholar/api/crossref
SCITEX_SCHOLAR_CROSSREF_API_URL_LOCAL=http://127.0.0.1:8000
SCITEX_SCHOLAR_CROSSREF_API_URL=${SCITEX_SCHOLAR_CROSSREF_API_URL_LOCAL}

# Citation Graph
SCITEX_SCHOLAR_CITATION_GRAPH_PROXY_URL=https://scitex.ai

# ========================================
# SciTeX Scholar - OpenAthens/SSO (Optional)
# ========================================
SCITEX_SCHOLAR_OPENATHENS_ENABLED=false
SCITEX_SCHOLAR_OPENATHENS_USERNAME=
SCITEX_SCHOLAR_OPENATHENS_EMAIL=
SCITEX_SCHOLAR_OPENATHENS_PASSWORD=
SCITEX_SCHOLAR_SSO_EMAIL=
SCITEX_SCHOLAR_SSO_USERNAME=
SCITEX_SCHOLAR_SSO_PASSWORD=
SCITEX_SCHOLAR_OPENURL_RESOLVER_URL=

# ========================================
# SciTeX Scholar - Browser Backend
# ========================================
SCITEX_SCHOLAR_BROWSER_BACKEND=zenrows

# ZenRows API (Optional)
SCITEX_SCHOLAR_ZENROWS_API_KEY=
SCITEX_SCHOLAR_ZENROWS_PROXY_DOMAIN=superproxy.zenrows.com
SCITEX_SCHOLAR_ZENROWS_PROXY_PORT=1337
SCITEX_SCHOLAR_ZENROWS_PROXY_USERNAME=
SCITEX_SCHOLAR_ZENROWS_PROXY_PASSWORD=
SCITEX_SCHOLAR_ZENROWS_PROXY_COUNTRY=au

# CAPTCHA Solvers (Optional)
SCITEX_SCHOLAR_2CAPTCHA_API_KEY=
SCITEX_SCHOLAR_CAPTCHA_SOLVER_API_KEY=

# Semantic Scholar (Optional)
SCITEX_SCHOLAR_SEMANTIC_SCHOLAR_API_KEY=

# Zotero
SCITEX_SCHOLAR_ZOTERO_TRANSLATORS_DIR=/app/.scitex/scholar/zotero_translators/

# ========================================
# SciTeX Writer
# ========================================
SCITEX_WRITER_TEMPLATE_BRANCH=main
SCITEX_WRITER_TEMPLATE_TAG=

# ========================================
# Test Users
# ========================================
SCITEX_HUB_TEST_USER_USERNAME=test-user
SCITEX_HUB_TEST_USER_PASSWORD=CHANGE_ME_TEST_PASSWORD
SCITEX_HUB_TEST_USER_EMAIL=test@example.com

# ========================================
# System
# ========================================
SCITEX_CORE_SUPPRESS_IMPORTING_MESSAGES=True
SCITEX_DIR=/home/user/.scitex

# ========================================
# Resource Quotas
# ========================================
# SLURM Job Quotas
SCITEX_HUB_QUOTA_SLURM_MAX_CONCURRENT_JOBS=4
SCITEX_HUB_QUOTA_SLURM_MAX_QUEUED_JOBS=8
SCITEX_HUB_QUOTA_SLURM_MAX_CPU_HOURS_DAILY=32
SCITEX_HUB_QUOTA_SLURM_MAX_CPU_HOURS_MONTHLY=512
SCITEX_HUB_QUOTA_SLURM_MAX_MEMORY_GB_PER_JOB=8
SCITEX_HUB_QUOTA_SLURM_MAX_RUNTIME_HOURS=32
SCITEX_HUB_QUOTA_SLURM_DEFAULT_PARTITION=normal
SCITEX_HUB_QUOTA_SLURM_ALLOWED_PARTITIONS=normal,express,long

# SLURM Interactive Terminal
SCITEX_HUB_QUOTA_SLURM_INTERACTIVE_PARTITION=express
SCITEX_HUB_QUOTA_SLURM_INTERACTIVE_TIME_LIMIT=00:59:00
SCITEX_HUB_QUOTA_SLURM_INTERACTIVE_CPUS=2
SCITEX_HUB_QUOTA_SLURM_INTERACTIVE_MEMORY_GB=4

# Celery Rate Limits
SCITEX_HUB_QUOTA_CELERY_AI_CALLS_PER_MINUTE=8
SCITEX_HUB_QUOTA_CELERY_SEARCH_PER_MINUTE=32
SCITEX_HUB_QUOTA_CELERY_COMPUTE_PER_MINUTE=16
SCITEX_HUB_QUOTA_CELERY_PDF_PER_HOUR=128
SCITEX_HUB_QUOTA_CELERY_MAX_TASK_RUNTIME=512

# Storage Quotas
SCITEX_HUB_QUOTA_STORAGE_TOTAL_GB=64
SCITEX_HUB_QUOTA_STORAGE_PROJECT_MAX_GB=16
SCITEX_HUB_QUOTA_STORAGE_FILE_UPLOAD_MB=128
SCITEX_HUB_QUOTA_STORAGE_TEMP_GB=8

# Project Quotas
SCITEX_HUB_QUOTA_MAX_PROJECTS=64
SCITEX_HUB_QUOTA_MAX_COLLABORATORS_PER_PROJECT=16
SCITEX_HUB_QUOTA_MAX_API_KEYS=8

# Request Throttling
SCITEX_HUB_QUOTA_HTTP_REQUESTS_PER_MINUTE=128
SCITEX_HUB_QUOTA_WEBSOCKET_CONNECTIONS=8

# ========================================
# SLURM Configuration
# ========================================
SCITEX_HUB_SLURM_HOST=localhost
SCITEX_HUB_SLURM_VERSION=24.05.5
SCITEX_HUB_SLURM_CONTAINER_PATH=/path/to/singularity/current-sandbox
SCITEX_HUB_SLURM_USER_DATA_ROOT=/path/to/data/users
SCITEX_HUB_USER_DATA_ROOT=/app/data/users
SCITEX_HUB_VISITOR_POOL_SIZE=4

# Dev mode: mount full repos into Apptainer for editable install
# Format: name:host_path:extras (comma-separated)
# On first login, bashrc runs `pip install -e /dev/{name}[extras]` for each repo
# Production containers skip this entirely (no /dev/ mounts present)
# Example: scitex-python:/home/user/proj/scitex-python:all,figrecipe:/home/user/proj/figrecipe:all
# SCITEX_HUB_DEV_REPOS=

# ========================================
# OAuth - Social Login
# ========================================
# Google OAuth
SCITEX_HUB_GOOGLE_CLIENT_ID=
SCITEX_HUB_GOOGLE_CLIENT_SECRET=

# ORCID OAuth
SCITEX_HUB_ORCID_CLIENT_ID=
SCITEX_HUB_ORCID_CLIENT_SECRET=
ORCID_BASE_DOMAIN=orcid.org

# ========================================
# Umami Analytics
# ========================================
SCITEX_HUB_UMAMI_PORT_DEV=3300
SCITEX_HUB_UMAMI_APP_SECRET=CHANGE_ME_UMAMI_SECRET
SCITEX_HUB_UMAMI_WEBSITE_ID=
SCITEX_HUB_UMAMI_SCRIPT_URL=http://127.0.0.1:3300/script.js
SCITEX_HUB_UMAMI_DOMAINS=
# Comma-separated IPs to exclude from analytics
SCITEX_HUB_UMAMI_IGNORE_IP=

# EOF

# ---------------------------------------
# Site domain (django.contrib.sites)
# ---------------------------------------
# NOT a separate variable. The ONE Site row that SITE_ID pins allauth and
# Django to takes its domain from the HOST PART of SCITEX_HUB_SITE_URL above,
# derived in config/settings/settings_auth.py and applied at container start by
# `manage.py sync_site_domain`.
#
# So set SCITEX_HUB_SITE_URL and nothing else. Production was found holding a
# Site domain of "127.0.0.1:8000" while SCITEX_HUB_SITE_URL already said
# https://scitex.ai -- the configuration was right and nothing applied it.
#
# With SCITEX_HUB_SITE_URL unset, sync_site_domain REFUSES rather than stamping
# the development fallback onto whatever database it is pointed at.
#
# Optional, cosmetic label for the same row:
SCITEX_HUB_SITE_NAME=SciTeX

