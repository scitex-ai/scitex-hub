# SciTeX Cloud - Environment Template
# Copy to .env.dev, .env.staging, or .env.prod and fill in values

# ========================================
# Django Settings
# ========================================
SCITEX_CLOUD_DJANGO_SETTINGS_MODULE=config.settings.settings_dev
DEBUG=True

# ========================================
# SciTeX Environment
# ========================================
SCITEX_ENV=dev
SCITEX_CLOUD_ENV=dev

# ========================================
# Server Ports
# ========================================
SCITEX_CLOUD_HTTP_PORT_DEV=8000

# Secret Key (generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
SCITEX_CLOUD_DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_NEW_SECRET

# ========================================
# Domain & Security
# ========================================
SCITEX_CLOUD_SERVER_IP=127.0.0.1
SCITEX_CLOUD_DOMAIN=127.0.0.1
SCITEX_CLOUD_GIT_DOMAIN=127.0.0.1
SCITEX_CLOUD_SITE_URL=http://127.0.0.1:8000
SCITEX_CLOUD_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# SSL/HTTPS Settings
SCITEX_CLOUD_ENABLE_SSL_REDIRECT=false
SCITEX_CLOUD_FORCE_HTTPS_COOKIES=false

# ========================================
# Database - PostgreSQL
# ========================================
SCITEX_CLOUD_POSTGRES_DB=scitex_cloud_dev
SCITEX_CLOUD_POSTGRES_USER=scitex_dev
SCITEX_CLOUD_POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
SCITEX_CLOUD_POSTGRES_URL=postgresql://scitex_dev:CHANGE_ME_DB_PASSWORD@postgres:5432/scitex_cloud_dev  # pragma: allowlist secret

SCITEX_CLOUD_DB_NAME_DEV=scitex_cloud_dev
SCITEX_CLOUD_DB_USER_DEV=scitex_dev
SCITEX_CLOUD_DB_PASSWORD_DEV=CHANGE_ME_DB_PASSWORD
SCITEX_CLOUD_DB_HOST_DEV=postgres
SCITEX_CLOUD_DB_PORT_DEV=5432

# ========================================
# Redis Cache
# ========================================
SCITEX_CLOUD_REDIS_URL=redis://redis:6379/0

# ========================================
# Logging
# ========================================
SCITEX_LOGGING_LEVEL=info

# ========================================
# Email Configuration
# ========================================
SCITEX_CLOUD_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SCITEX_CLOUD_EMAIL_HOST=smtp.example.com
SCITEX_CLOUD_EMAIL_PORT=587
SCITEX_CLOUD_EMAIL_USE_TLS=True
SCITEX_CLOUD_EMAIL_HOST_USER=no-reply@example.com
SCITEX_CLOUD_EMAIL_HOST_PASSWORD=CHANGE_ME_EMAIL_PASSWORD

SCITEX_CLOUD_EMAIL_ADMIN=admin@example.com
SCITEX_CLOUD_EMAIL_SUPPORT=support@example.com
SCITEX_CLOUD_EMAIL_NO_REPLY=no-reply@example.com

# ========================================
# Gitea Integration
# ========================================
SCITEX_CLOUD_GITEA_URL_DEV=http://127.0.0.1:3000
SCITEX_CLOUD_GITEA_HTTP_PORT_DEV=3000
SCITEX_CLOUD_GITEA_SSH_PORT_DEV=2222
SCITEX_CLOUD_GITEA_API_URL_DEV=http://127.0.0.1:3000/api/v1

SCITEX_CLOUD_GITEA_URL_IN_HOST_DEV=http://127.0.0.1:3000
SCITEX_CLOUD_GITEA_URL_IN_CONTAINER_DEV=http://gitea:3000

SCITEX_CLOUD_GITEA_ADMIN_USERNAME=scitex_admin
SCITEX_CLOUD_GITEA_ADMIN_PASSWORD=CHANGE_ME_GITEA_PASSWORD
SCITEX_CLOUD_GITEA_ADMIN_EMAIL=admin@example.com
SCITEX_CLOUD_GITEA_TOKEN_DEV=CHANGE_ME_GITEA_TOKEN

# ========================================
# CrossRef/OpenAlex Local Database
# ========================================
CROSSREF_LOCAL_MODE=http
CROSSREF_LOCAL_API_URL=http://host.docker.internal:31291
CROSSREF_LOCAL_PORT=31291

OPENALEX_LOCAL_MODE=http
OPENALEX_LOCAL_API_URL=http://host.docker.internal:31292
OPENALEX_LOCAL_PORT=31292

# ========================================
# SciTeX Scholar Configuration
# ========================================
SCITEX_SCHOLAR_USE_CACHE=True
SCITEX_SCHOLAR_MAX_WORKERS=8
SCITEX_SCHOLAR_TIMEOUT_PER_ENGINE=30
SCITEX_SCHOLAR_ENGINES=CrossRef,PubMed,Semantic_Scholar,arXiv,OpenAlex
SCITEX_SCHOLAR_DEFAULT_MODE=parallel
SCITEX_SCHOLAR_DEBUG_MODE=true
SCITEX_SCHOLAR_PDF_MAX_PARALLEL=8

# Scholar Email
SCITEX_SCHOLAR_FROM_EMAIL_ADDRESS=no-reply@example.com
SCITEX_SCHOLAR_FROM_EMAIL_SENDER_NAME="SciTeX Scholar"
SCITEX_SCHOLAR_FROM_EMAIL_SMTP_SERVER=smtp.example.com
SCITEX_SCHOLAR_FROM_EMAIL_SMTP_PORT=587
SCITEX_SCHOLAR_FROM_EMAIL_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
SCITEX_SCHOLAR_TO_EMAIL_ADDRESS=your@email.com
SCITEX_SCHOLAR_CROSSREF_EMAIL=your@email.com
SCITEX_SCHOLAR_PUBMED_EMAIL=your@email.com

# ========================================
# SciTeX Public API
# ========================================
SCITEX_CLOUD_CAMPAIGN_API_KEY=CHANGE_ME_API_KEY

# Scholar API Endpoints
SCITEX_SCHOLAR_CROSSREF_API_URL_EXTERNAL=https://scitex.ai/scholar/api/crossref
SCITEX_SCHOLAR_CROSSREF_API_URL_LOCAL=http://127.0.0.1:8000
SCITEX_SCHOLAR_CROSSREF_API_URL=${SCITEX_SCHOLAR_CROSSREF_API_URL_LOCAL}

# Citation Graph
SCITEX_SCHOLAR_CITATION_GRAPH_PROXY_URL=https://scitex.ai

# ========================================
# SciTeX Scholar - OpenAthens/SSO (Optional)
# ========================================
SCITEX_SCHOLAR_OPENATHENS_ENABLED=false
SCITEX_SCHOLAR_OPENATHENS_USERNAME=
SCITEX_SCHOLAR_OPENATHENS_EMAIL=
SCITEX_SCHOLAR_OPENATHENS_PASSWORD=
SCITEX_SCHOLAR_SSO_EMAIL=
SCITEX_SCHOLAR_SSO_USERNAME=
SCITEX_SCHOLAR_SSO_PASSWORD=
SCITEX_SCHOLAR_OPENURL_RESOLVER_URL=

# ========================================
# SciTeX Scholar - Browser Backend
# ========================================
SCITEX_SCHOLAR_BROWSER_BACKEND=zenrows

# ZenRows API (Optional)
SCITEX_SCHOLAR_ZENROWS_API_KEY=
SCITEX_SCHOLAR_ZENROWS_PROXY_DOMAIN=superproxy.zenrows.com
SCITEX_SCHOLAR_ZENROWS_PROXY_PORT=1337
SCITEX_SCHOLAR_ZENROWS_PROXY_USERNAME=
SCITEX_SCHOLAR_ZENROWS_PROXY_PASSWORD=
SCITEX_SCHOLAR_ZENROWS_PROXY_COUNTRY=au

# CAPTCHA Solvers (Optional)
SCITEX_SCHOLAR_2CAPTCHA_API_KEY=
SCITEX_SCHOLAR_CAPTCHA_SOLVER_API_KEY=

# Semantic Scholar (Optional)
SCITEX_SCHOLAR_SEMANTIC_SCHOLAR_API_KEY=

# Zotero
SCITEX_SCHOLAR_ZOTERO_TRANSLATORS_DIR=/app/.scitex/scholar/zotero_translators/

# ========================================
# SciTeX Writer
# ========================================
SCITEX_WRITER_TEMPLATE_BRANCH=main
SCITEX_WRITER_TEMPLATE_TAG=

# ========================================
# Test Users
# ========================================
SCITEX_CLOUD_TEST_USER_USERNAME=test-user
SCITEX_CLOUD_TEST_USER_PASSWORD=CHANGE_ME_TEST_PASSWORD
SCITEX_CLOUD_TEST_USER_EMAIL=test@example.com

# ========================================
# System
# ========================================
SCITEX_CORE_SUPPRESS_IMPORTING_MESSAGES=True
SCITEX_DIR=/home/user/.scitex

# ========================================
# Resource Quotas
# ========================================
# SLURM Job Quotas
SCITEX_CLOUD_QUOTA_SLURM_MAX_CONCURRENT_JOBS=4
SCITEX_CLOUD_QUOTA_SLURM_MAX_QUEUED_JOBS=8
SCITEX_CLOUD_QUOTA_SLURM_MAX_CPU_HOURS_DAILY=32
SCITEX_CLOUD_QUOTA_SLURM_MAX_CPU_HOURS_MONTHLY=512
SCITEX_CLOUD_QUOTA_SLURM_MAX_MEMORY_GB_PER_JOB=8
SCITEX_CLOUD_QUOTA_SLURM_MAX_RUNTIME_HOURS=32
SCITEX_CLOUD_QUOTA_SLURM_DEFAULT_PARTITION=normal
SCITEX_CLOUD_QUOTA_SLURM_ALLOWED_PARTITIONS=normal,express,long

# SLURM Interactive Terminal
SCITEX_CLOUD_QUOTA_SLURM_INTERACTIVE_PARTITION=express
SCITEX_CLOUD_QUOTA_SLURM_INTERACTIVE_TIME_LIMIT=00:59:00
SCITEX_CLOUD_QUOTA_SLURM_INTERACTIVE_CPUS=2
SCITEX_CLOUD_QUOTA_SLURM_INTERACTIVE_MEMORY_GB=4

# Celery Rate Limits
SCITEX_CLOUD_QUOTA_CELERY_AI_CALLS_PER_MINUTE=8
SCITEX_CLOUD_QUOTA_CELERY_SEARCH_PER_MINUTE=32
SCITEX_CLOUD_QUOTA_CELERY_COMPUTE_PER_MINUTE=16
SCITEX_CLOUD_QUOTA_CELERY_PDF_PER_HOUR=128
SCITEX_CLOUD_QUOTA_CELERY_MAX_TASK_RUNTIME=512

# Storage Quotas
SCITEX_CLOUD_QUOTA_STORAGE_TOTAL_GB=64
SCITEX_CLOUD_QUOTA_STORAGE_PROJECT_MAX_GB=16
SCITEX_CLOUD_QUOTA_STORAGE_FILE_UPLOAD_MB=128
SCITEX_CLOUD_QUOTA_STORAGE_TEMP_GB=8

# Project Quotas
SCITEX_CLOUD_QUOTA_MAX_PROJECTS=64
SCITEX_CLOUD_QUOTA_MAX_COLLABORATORS_PER_PROJECT=16
SCITEX_CLOUD_QUOTA_MAX_API_KEYS=8

# Request Throttling
SCITEX_CLOUD_QUOTA_HTTP_REQUESTS_PER_MINUTE=128
SCITEX_CLOUD_QUOTA_WEBSOCKET_CONNECTIONS=8

# ========================================
# SLURM Configuration
# ========================================
SCITEX_CLOUD_SLURM_HOST=localhost
SCITEX_CLOUD_SLURM_VERSION=24.05.5
SCITEX_CLOUD_SLURM_CONTAINER_PATH=/path/to/singularity/current-sandbox
SCITEX_CLOUD_SLURM_USER_DATA_ROOT=/path/to/data/users
SCITEX_CLOUD_USER_DATA_ROOT=/app/data/users
SCITEX_CLOUD_VISITOR_POOL_SIZE=4

# Dev mode: mount full repos into Apptainer for editable install
# Format: name:host_path:extras (comma-separated)
# On first login, bashrc runs `pip install -e /dev/{name}[extras]` for each repo
# Production containers skip this entirely (no /dev/ mounts present)
# Example: scitex-python:/home/user/proj/scitex-python:all,figrecipe:/home/user/proj/figrecipe:all
# SCITEX_CLOUD_DEV_REPOS=

# ========================================
# OAuth - Social Login
# ========================================
# Google OAuth
SCITEX_CLOUD_GOOGLE_CLIENT_ID=
SCITEX_CLOUD_GOOGLE_CLIENT_SECRET=

# ORCID OAuth
SCITEX_CLOUD_ORCID_CLIENT_ID=
SCITEX_CLOUD_ORCID_CLIENT_SECRET=
ORCID_BASE_DOMAIN=orcid.org

# ========================================
# Umami Analytics
# ========================================
SCITEX_CLOUD_UMAMI_PORT_DEV=3300
SCITEX_CLOUD_UMAMI_APP_SECRET=CHANGE_ME_UMAMI_SECRET
SCITEX_CLOUD_UMAMI_WEBSITE_ID=
SCITEX_CLOUD_UMAMI_SCRIPT_URL=http://127.0.0.1:3300/script.js
SCITEX_CLOUD_UMAMI_DOMAINS=
# Comma-separated IPs to exclude from analytics
SCITEX_CLOUD_UMAMI_IGNORE_IP=

# EOF
