{
  "$schema": "scitex-app-manifest",
  "$schema_version": "2.0.0",
  "name": "discovery",
  "label": "Explore",
  "app_name": "discovery_app",
  "icon": "fas fa-compass",
  "description": "Discover public repositories, researchers, and organizations.",
  "version": "0.14.0",
  "license": "AGPL-3.0",
  "keyboard_shortcut": "X",
  "order": 70,
  "accent_color": "discovery",
  "body_class": "discovery-page",
  "partial_template": "discovery_app/discovery_partial.html",
  "context_builder": "apps.workspace.discovery_app.views.build_discovery_context",
  "url": "/apps/discovery/",
  "ai_hint": "Discover public repositories, researchers, and organizations.",
  "allowed_extensions": [],
  "hidden_patterns": ["__pycache__", "node_modules", ".git", ".venv"],
  "privileges": [
    {"type": "network", "scope": "api.dandi.org,api.openneuro.org,physionet.org", "reason": "Search and fetch public dataset metadata"}
  ],
  "builtin": true,
  "dependencies": {
    "python": [],
    "system": [],
    "node": [],
    "r": [],
    "other": []
  },
  "container": null
}
