{
  "$schema": "scitex-app-manifest",
  "$schema_version": "1.0.0",
  "name": "vis",
  "label": "Vis",
  "app_name": "vis_app",
  "icon": "fas fa-chart-line",
  "description": "Data visualization and figure management: view plots, manage figure recipes, export publication-ready figures.",
  "version": "0.14.0",
  "license": "AGPL-3.0",
  "keyboard_shortcut": "V",
  "order": 40,
  "accent_color": "visualizer",
  "body_class": "vis-workspace",
  "partial_template": "vis_app/vis_partial.html",
  "context_builder": "",
  "ai_hint": "Data visualization and figure management: view plots, manage figure recipes, export publication-ready figures.",
  "allowed_extensions": [".png", ".jpg", ".jpeg", ".svg", ".pdf", ".csv", ".json", ".xlsx", ".tsv"],
  "hidden_patterns": ["__pycache__", "node_modules", ".git", ".venv"],
  "builtin": true,
  "dependencies": {
    "python": [],
    "system": [],
    "node": [],
    "r": [],
    "other": []
  },
  "container": null
}
