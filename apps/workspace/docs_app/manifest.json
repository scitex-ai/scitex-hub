{
  "$schema": "scitex-app-manifest",
  "$schema_version": "2.0.0",
  "name": "docs",
  "label": "Docs",
  "app_name": "docs_app",
  "icon": "fas fa-book",
  "description": "Documentation: Python packages, MCP tools, SSH access, API reference, self-hosting guide, licensing.",
  "version": "0.14.0",
  "license": "AGPL-3.0",
  "keyboard_shortcut": "D",
  "order": 80,
  "accent_color": "docs",
  "body_class": "docs-page",
  "partial_template": "docs_app/docs_partial.html",
  "context_builder": "apps.workspace.docs_app.views.build_docs_context",
  "url": "/apps/docs/",
  "ai_hint": "Documentation: Python packages, MCP tools, SSH access, API reference, self-hosting guide, licensing.",
  "allowed_extensions": [],
  "hidden_patterns": ["__pycache__", "node_modules", ".git", ".venv"],
  "privileges": [],
  "builtin": true,
  "dependencies": {
    "python": [],
    "system": [],
    "node": [],
    "r": [],
    "other": []
  },
  "container": null
}
