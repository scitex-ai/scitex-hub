{
  "$schema": "scitex-app-manifest",
  "$schema_version": "2.0.0",
  "name": "scholar",
  "label": "Scholar",
  "app_name": "scholar_app",
  "icon": "fas fa-graduation-cap",
  "description": "Literature management: search papers (CrossRef/OpenAlex/Semantic Scholar), manage bibliography, explore citation graphs, download PDFs.",
  "pip_package": "scitex-scholar",
  "license": "AGPL-3.0",
  "keyboard_shortcut": "S",
  "order": 30,
  "accent_color": "scholar",
  "body_class": "scholar-page",
  "partial_template": "scholar_app/scholar_partial.html",
  "context_builder": "apps.workspace.scholar_app.views.build_scholar_context",
  "ai_hint": "Literature management: search papers (CrossRef/OpenAlex/Semantic Scholar), manage bibliography, explore citation graphs, download PDFs.",
  "allowed_extensions": [".bib"],
  "hidden_patterns": ["__pycache__", "node_modules", ".git", ".venv", "build"],
  "privileges": [
    {"type": "filesystem", "scope": "project", "reason": "Read/write bibliography files (.bib)"},
    {"type": "network", "scope": "api.crossref.org,api.openalex.org,api.semanticscholar.org", "reason": "Search and fetch paper metadata"},
    {"type": "network", "scope": "pdf-download", "reason": "Download paper PDFs from publishers"}
  ],
  "builtin": true,
  "dependencies": {
    "python": [],
    "system": [],
    "node": [],
    "r": [],
    "other": []
  },
  "container": null
}
