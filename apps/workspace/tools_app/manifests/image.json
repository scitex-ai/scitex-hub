  "ai_hint": "Crop, resize, convert and combine figures; color picker and CSV plot viewer.",
  "allowed_extensions": [],
  "hidden_patterns": [
    "__pycache__",
    "node_modules",
    ".git",
    ".venv"
  ],
  "privileges": [],
  "builtin": true,
  "container": null
}
