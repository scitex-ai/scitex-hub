{
  "$schema": "scitex-app-manifest",
  "$schema_version": "2.0.0",
  "name": "tools-image",
  "label": "Image Tools",
  "app_name": "tools_app",
  "icon": "fas fa-image",
  "description": "Crop, resize, convert and combine figures; color picker and CSV plot viewer.",
  "license": "AGPL-3.0",
  "order": 35,
  "category": "utility",
  "accent_color": "tools",
  "body_class": "tools-page",
  "partial_template": "tools_app/tools_partial.html",
  "context_builder": "apps.workspace.tools_app.views.tools_views.build_image_tools_context",
  "url": "/apps/tools/image/",
